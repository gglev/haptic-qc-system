        <di:waypoint x="1700" y="292.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_15" bpmnElement="Flow_15">
        <di:waypoint x="1754" y="292.0" />
        <di:waypoint x="2000" y="307.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_16" bpmnElement="Flow_16">
        <di:waypoint x="1754" y="292.0" />
        <di:waypoint x="1820" y="307.5" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_17" bpmnElement="Flow_17">
        <di:waypoint x="1665" y="107.5" />
