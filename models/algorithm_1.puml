@startdot
digraph Validation {
  graph [rankdir=TB, bgcolor=white, labelloc=t, label="Алгоритм 1. Проверка таблицы измерений", fontname="Arial", nodesep=0.4, ranksep=0.4];
  node [shape=box, fontname="Arial", fontsize=12];
  edge [fontname="Arial", fontsize=11];
  start [style=rounded, label="Начало"];
  input [shape=parallelogram, label="Ввод CSV с тремя столбцами"];
  header [shape=diamond, label="Заголовок верен?"];
  init [label="n = число строк; i = 0\nrequired = список трех полей"];
  rows [shape=diamond, label="i < n?"];
  init_field [label="j = 0"];
  fields [shape=diamond, label="j < 3?"];
  check [shape=diamond, label="Поле required[j]\nв строке i заполнено?"];
  next_field [label="j = j + 1"];
  numbers [label="Преобразовать частоту и ускорение\nв числа"];
  valid [shape=diamond, label="Числа конечны,\nчастота > 0, ускорение >= 0?"];
  next_row [label="Добавить строку в список\ni = i + 1"];
  enough [shape=diamond, label="n >= 3?"];
  same [shape=diamond, label="Одно изделие\nи частоты не повторяются?"];
  result [shape=parallelogram, label="Вывод проверенных измерений"];
  error [shape=parallelogram, label="Сообщить причину ошибки"];
  end [style=rounded, label="Конец"];

  start -> input -> header;
  header -> init [label="Да"];
  header -> error [label="Нет", constraint=false];
  init -> rows;
  rows -> init_field [label="Да"];
  rows -> enough [label="Нет"];
  init_field -> fields;
  fields -> check [label="Да"];
  fields -> numbers [label="Нет"];
  check -> next_field [label="Да"];
  check -> error [label="Нет", constraint=false];
  next_field -> fields [constraint=false];
  numbers -> valid;
  numbers -> error [label="Ошибка преобразования", constraint=false];
  valid -> next_row [label="Да"];
  valid -> error [label="Нет", constraint=false];
  next_row -> rows [constraint=false];
  enough -> same [label="Да"];
  enough -> error [label="Нет", constraint=false];
  same -> result [label="Да"];
  same -> error [label="Нет", constraint=false];
  result -> end;
  error -> end;
  next_field -> numbers [style=invis];
  next_row -> enough [style=invis];
  {rank=same; result; error;}
}
@enddot
