@startdot
digraph BPMN {
graph [layout=neato, overlap=true, splines=ortho, bgcolor="white", fontname="Arial", label="Выходной контроль LRA — один процесс с четырьмя дорожками", labelloc=t];
node [fontname="Arial", fontsize=11, margin="0.12,0.08", shape=box, style=rounded];
edge [fontname="Arial", fontsize=10];
subgraph cluster_otk {
otk_nw [shape=point, style=invis, width=0, pos="0.00,11.11!", pin=true];
otk_se [shape=point, style=invis, width=0, pos="43.00,8.33!", pin=true];
 label="ОТК"; color="#999999";
 start [pos="1.36,9.96!", pin=true, shape=circle, label="", width=0.25, style=solid];
 identify [pos="8.65,9.62!", pin=true, label="Сканировать номер\nУстановить изделие"];
 failure [pos="21.98,9.62!", pin=true, label="Зафиксировать\nнесоответствие изделия"];
 sort [pos="38.65,9.62!", pin=true, label="Сортировать по статусу"];
 finish [pos="40.53,9.96!", pin=true, shape=circle, penwidth=3, label="", width=0.25, style=solid];
}
subgraph cluster_sw {
sw_nw [shape=point, style=invis, width=0, pos="0.00,8.33!", pin=true];
sw_se [shape=point, style=invis, width=0, pos="43.00,5.56!", pin=true];
 label="ПО"; color="#999999";
 check [pos="11.28,6.84!", pin=true, label="Проверить рецепт\nи допуск стенда"];
 ready [pos="13.15,7.06!", pin=true, shape=diamond, style=solid, width=1.35, height=0.75, fixedsize=true, fontsize=9, label="X\nСтенд готов?"];
 measure [pos="15.87,6.84!", pin=true, label="Измерить частотный отклик\nРассчитать показатели"];
 valid [pos="17.88,7.06!", pin=true, shape=diamond, style=solid, width=1.35, height=0.75, fixedsize=true, fontsize=9, label="X\nДанные\nвалидны?"];
 quality [pos="19.40,7.06!", pin=true, shape=diamond, style=solid, width=1.35, height=0.75, fixedsize=true, fontsize=9, label="X\nДопуски\nсоблюдены?"];
 write [pos="21.98,6.84!", pin=true, label="Записать EEPROM\nПрочитать и сравнить"];
 written [pos="23.99,7.06!", pin=true, shape=diamond, style=solid, width=1.35, height=0.75, fixedsize=true, fontsize=9, label="X\nЗапись\nподтверждена?"];
 technical [pos="26.42,6.84!", pin=true, label="Заблокировать выпуск\nЗафиксировать ошибку записи"];
 persist [pos="28.92,6.84!", pin=true, label="Сохранить протокол\nи очередь отправки"];
 send [pos="31.56,6.84!", pin=true, label="Передать протокол\nс номером протокола"];
 timeout [pos="36.07,7.06!", pin=true, shape=diamond, style=solid, width=1.35, height=0.75, fixedsize=true, fontsize=9, label="X\nЕсть\nподтверждение?"];
 pending [pos="38.65,6.84!", pin=true, label="Сохранить статус\nожидания синхронизации"];
 timer [pos="40.53,7.18!", pin=true, shape=doublecircle, style=solid, label="T", width=0.4];
}
subgraph cluster_metrology {
metrology_nw [shape=point, style=invis, width=0, pos="0.00,5.56!", pin=true];
metrology_se [shape=point, style=invis, width=0, pos="43.00,2.78!", pin=true];
 label="Метролог"; color="#999999";
 approve [pos="3.37,4.06!", pin=true, label="Утвердить методику\nи версию допусков"];
 investigate [pos="13.92,4.06!", pin=true, label="Устранить причину\nРазрешить новый запуск"];
}
subgraph cluster_mes {
mes_nw [shape=point, style=invis, width=0, pos="0.00,2.78!", pin=true];
mes_se [shape=point, style=invis, width=0, pos="43.00,0.00!", pin=true];
 label="MES/ERP"; color="#999999";
 job [pos="6.01,1.28!", pin=true, label="Выдать задание\nи версию рецепта"];
 accept [pos="31.56,1.28!", pin=true, label="Принять протокол\nили вернуть существующий"];
 status [pos="34.20,1.28!", pin=true, label="Зафиксировать статус\nПодтвердить прием"];
}
start -> approve -> job -> identify -> check -> ready;
ready -> measure [label="Да"];
ready -> investigate [label="Нет"];
investigate -> check;
measure -> valid;
valid -> quality [label="Да"];
valid -> investigate [label="Нет"];
quality -> write [label="Да"];
quality -> failure [label="Нет"];
write -> written;
written -> persist [label="Да"];
written -> technical [label="Нет"];
failure -> persist;
technical -> persist;
persist -> send -> accept -> status -> timeout;
timeout -> sort [label="Да"];
timeout -> pending [label="Нет / тайм-аут"];
pending -> timer -> send;
sort -> finish;
}
@enddot
